<div class="login-container">
  <div class="login-box">
    <div class="login-header">
      <h1>CAMAAR</h1>
      <h2>Sistema de Avaliação Acadêmica</h2>
    </div>
    
    <%= form_with(url: login_path, local: true, class: "login-form") do |f| %>
      <div class="form-group">
        <%= f.label :login, "Email ou Matrícula" %>
        <%= f.text_field :login, 
                          placeholder: "seu.email@unb.br ou matrícula", 
                          class: "form-control",
                          autofocus: true,
                          required: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :password, "Senha" %>
        <%= f.password_field :password, 
                             placeholder: "Digite sua senha",
                             class: "form-control",
                             required: true %>
      </div>
      
      <div class="form-actions">
        <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>
    
    <div class="login-footer">
      <p class="text-muted">
        Sistema desenvolvido para a Universidade de Brasília
      </p>
      <p><%= link_to "Esqueci minha senha", redefinir_senha_path %></p>
    </div>
  </div>
</div>