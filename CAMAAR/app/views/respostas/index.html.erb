<%# app/views/respostas/index.html.erb %>

<div class="container-resultados">
  <%# Header %>
  <div class="resultados-header">
    <div>
      <h1>📊 Resultados: <%= @formulario.titulo %></h1>
      <p class="subtitulo">
        <% if @formulario.materia.present? %>
          <%= @formulario.materia.nome %> •
        <% end %>
        <%= @formulario.destinatario_humanizado %>
      </p>
    </div>
    <div class="header-acoes">
      <%= link_to "📥 Baixar CSV", relatorios_formulario_csv_path(@formulario, format: :csv), class: "btn btn-success" %>
      <%= link_to "← Voltar", formularios_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <%# Estatísticas %>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">📝</div>
      <div class="stat-content">
        <div class="stat-label">Respostas</div>
        <div class="stat-value"><%= @total_respostas %></div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-icon">🎯</div>
      <div class="stat-content">
        <div class="stat-label">Esperado</div>
        <div class="stat-value"><%= @total_esperado %></div>
      </div>
    </div>
    
    <div class="stat-card <%= taxa_classe(@taxa_resposta) %>">
      <div class="stat-icon">📈</div>
      <div class="stat-content">
        <div class="stat-label">Taxa</div>
        <div class="stat-value"><%= @taxa_resposta %>%</div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-icon">📅</div>
      <div class="stat-content">
        <div class="stat-label">Prazo</div>
        <div class="stat-value-small"><%= @formulario.data_fim.strftime('%d/%m/%Y') %></div>
      </div>
    </div>
  </div>

  <%# Resultados por questão %>
  <div class="questoes-resultados">
    <% @questoes.each_with_index do |questao, index| %>
      <div class="questao-resultado">
        <div class="questao-resultado-header">
          <div>
            <span class="numero-resultado">Questão <%= index + 1 %></span>
            <span class="tipo-badge <%= questao.tipo %>">
              <%= questao.tipo == 'dissertativa' ? '📝 Dissertativa' : '☑️ Múltipla Escolha' %>
            </span>
          </div>
          <span class="total-resp">
            <%= (@respostas_por_questao[questao.id] || []).count %> respostas
          </span>
        </div>
        
        <div class="questao-texto-resultado">
          <%= simple_format(questao.enunciado) %>
        </div>
        
        <div class="questao-dados">
          <% if questao.tipo == 'multipla_escolha' %>
            <%# Estatísticas Múltipla Escolha %>
            <div class="multipla-stats">
              <% stats = @estatisticas_multipla[questao.id] || [] %>
              <% if stats.any? %>
                <% stats.each do |stat| %>
                  <div class="opcao-stat">
                    <div class="opcao-stat-header">
                      <span class="opcao-texto-stat"><%= stat[:opcao].texto %></span>
                      <span class="opcao-count"><%= stat[:count] %> (<%= stat[:percentual] %>%)</span>
                    </div>
                    <div class="progress-bar">
                      <div class="progress-fill" style="width: <%= stat[:percentual] %>%"></div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <p class="sem-resp">Nenhuma resposta ainda</p>
              <% end %>
            </div>
            
          <% elsif questao.tipo == 'dissertativa' %>
            <%# Respostas Dissertativas %>
            <div class="dissertativas">
              <% respostas = @respostas_por_questao[questao.id] || [] %>
              <% if respostas.any? %>
                <button type="button" class="btn-toggle" onclick="toggleResp(<%= questao.id %>)">
                  Ver <%= respostas.count %> respostas ▼
                </button>
                
                <div id="resp-<%= questao.id %>" class="respostas-lista" style="display: none;">
                  <% respostas.each_with_index do |resposta, i| %>
                    <div class="resposta-item">
                      <div class="resposta-meta">
                        <span class="resp-num">Resposta <%= i + 1 %></span>
                        <span class="resp-data"><%= resposta.respondido_em.strftime('%d/%m/%Y %H:%M') %></span>
                      </div>
                      <div class="resposta-texto">
                        <%= simple_format(resposta.conteudo) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="sem-resp">Nenhuma resposta ainda</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
.container-resultados {
  max-width: 1200px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.resultados-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 2rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
}

.resultados-header h1 {
  margin: 0 0 0.5rem 0;
  font-size: 2rem;
  font-weight: 700;
}

.subtitulo {
  margin: 0;
  opacity: 0.9;
  font-size: 1.05rem;
}

.header-acoes {
  display: flex;
  gap: 1rem;
  flex-shrink: 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: white;
  border: 2px solid #e9ecef;
  border-radius: 12px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  transition: all 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.stat-card.alta {
  background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
  border-color: #28a745;
}

.stat-card.media {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);
  border-color: #ffc107;
}

.stat-card.baixa {
  background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
  border-color: #dc3545;
}

.stat-icon { font-size: 2.5rem; }

.stat-label {
  font-size: 0.85rem;
  color: #6c757d;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: #2c3e50;
}

.stat-value-small {
  font-size: 1.25rem;
  font-weight: 700;
  color: #2c3e50;
}

.questoes-resultados {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.questao-resultado {
  background: white;
  border: 2px solid #e9ecef;
  border-radius: 12px;
  padding: 1.5rem;
}

.questao-resultado-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #f8f9fa;
}

.numero-resultado {
  font-weight: 700;
  font-size: 1.1rem;
  color: #667eea;
  margin-right: 1rem;
}

.tipo-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.tipo-badge.dissertativa {
  background: #e3f2fd;
  color: #1976d2;
}

.tipo-badge.multipla_escolha {
  background: #f3e5f5;
  color: #7b1fa2;
}

.total-resp {
  font-size: 0.95rem;
  color: #6c757d;
  font-weight: 600;
}

.questao-texto-resultado {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #2c3e50;
  margin-bottom: 1.5rem;
  font-weight: 500;
}

.multipla-stats {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.opcao-stat {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 8px;
}

.opcao-stat-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.opcao-texto-stat {
  font-weight: 600;
  color: #2c3e50;
}

.opcao-count {
  font-weight: 700;
  color: #667eea;
}

.progress-bar {
  width: 100%;
  height: 12px;
  background: #e9ecef;
  border-radius: 6px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.5s ease;
}

.btn-toggle {
  width: 100%;
  padding: 0.75rem 1rem;
  background: #f8f9fa;
  border: 2px solid #e9ecef;
  border-radius: 8px;
  font-weight: 600;
  color: #667eea;
  cursor: pointer;
}

.btn-toggle:hover {
  background: #e9ecef;
  border-color: #667eea;
}

.respostas-lista {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-height: 500px;
  overflow-y: auto;
}

.resposta-item {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 8px;
  border-left: 4px solid #667eea;
}

.resposta-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  font-size: 0.85rem;
}

.resp-num {
  font-weight: 700;
  color: #667eea;
}

.resp-data {
  color: #6c757d;
}

.resposta-texto {
  color: #2c3e50;
  line-height: 1.6;
}

.sem-resp {
  color: #6c757d;
  font-style: italic;
  text-align: center;
  padding: 2rem;
}

.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
}

.btn-success {
  background: #28a745;
  color: white;
}

.btn-success:hover {
  background: #218838;
}

.btn-secondary {
  background: #6c757d;
  color: white;
}

.btn-secondary:hover {
  background: #5a6268;
}

@media (max-width: 768px) {
  .resultados-header {
    flex-direction: column;
  }
  .header-acoes {
    width: 100%;
  }
  .header-acoes .btn {
    flex: 1;
  }
  .stats-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
function toggleResp(id) {
  const container = document.getElementById(`resp-${id}`);
  const button = event.target;
  
  if (container.style.display === 'none') {
    container.style.display = 'flex';
    button.textContent = button.textContent.replace('▼', '▲');
  } else {
    container.style.display = 'none';
    button.textContent = button.textContent.replace('▲', '▼');
  }
}
</script>

<%
def taxa_classe(taxa)
  if taxa >= 70
    'alta'
  elsif taxa >= 40
    'media'
  else
    'baixa'
  end
end
%>
