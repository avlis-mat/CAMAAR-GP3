<!DOCTYPE html>
<html>
  <head>
    <title>CAMAAR - Sistema de Avaliação Acadêmica</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? %>
      <nav class="navbar">
        <div class="container">
          <div class="navbar-brand">
            <%= link_to "CAMAAR", root_path, class: "brand-link" %>
          </div>
          
          <div class="navbar-menu">
            <% if administrador? %>
              <%= link_to "Dashboard", root_path, class: "nav-link" %>
              <%= link_to "Templates", modelos_path, class: "nav-link" %>
              <%= link_to "Formulários", formularios_path, class: "nav-link" %>
            <% else %>
              <%= link_to "Início", root_path, class: "nav-link" %>
              <%= link_to "Formulários", formularios_path, class: "nav-link" %>
            <% end %>
            
            <div class="navbar-user">
              <span class="user-name"><%= current_usuario.nome %></span>
              <%= button_to "Sair", logout_path, method: :delete, class: "btn-logout" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>
    
    <% if flash.any? %>
      <div class="flash-messages">
        <% flash.each do |type, message| %>
          <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>
    
    <main class="main-content">
      <%= yield %>
    </main>
    
    <footer class="footer">
      <div class="container">
        <p>&copy; <%= Time.current.year %> CAMAAR - Universidade de Brasília</p>
      </div>
    </footer>
  </body>
</html>