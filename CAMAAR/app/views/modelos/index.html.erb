<!-- app/views/modelos/index.html.erb -->

<div class="container">
  <div class="page-header">
    <h1>Templates de Formulários</h1>
    <% if administrador? %>
      <%= link_to "Criar Novo Template", new_modelo_path, class: "btn btn-primary" %>
    <% end %>
  </div>
  
  <!-- Busca -->
  <div class="search-box">
    <%= form_with(url: modelos_path, method: :get, local: true, class: "search-form") do |f| %>
      <div class="search-input-group">
        <%= f.text_field :busca, 
                         value: params[:busca],
                         placeholder: "Buscar templates...", 
                         class: "form-control" %>
        <%= f.submit "Buscar", class: "btn btn-secondary" %>
        <% if params[:busca].present? %>
          <%= link_to "Limpar", modelos_path, class: "btn btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <% if @modelos.any? %>
    <div class="modelos-grid">
      <% @modelos.each do |modelo| %>
        <div class="modelo-card" id="modelo_<%= modelo.id %>">
          <div class="modelo-header">
            <h3><%= link_to modelo.nome, modelo_path(modelo) %></h3>
            <span class="modelo-badge modelo-badge-<%= modelo.status %>">
              <%= modelo.status.humanize %>
            </span>
          </div>
          
          <div class="modelo-body">
            <p class="modelo-descricao">
              <%= truncate(modelo.descricao, length: 150) %>
            </p>
            
            <div class="modelo-meta">
              <span class="meta-item">
                <strong><%= modelo.questoes.count %></strong> questões
              </span>
              <span class="meta-item">
                Versão <strong><%= modelo.versao %></strong>
              </span>
              <span class="meta-item">
                Criado em <%= modelo.created_at.strftime('%d/%m/%Y') %>
              </span>
            </div>
            
            <p class="modelo-autor">
              Por: <%= modelo.usuario.nome %>
            </p>
          </div>
          
          <div class="modelo-actions">
            <%= link_to "Ver Detalhes", modelo_path(modelo), class: "btn btn-sm btn-info" %>
            
            <% if administrador? %>
              <%= link_to "Editar", edit_modelo_path(modelo), class: "btn btn-sm btn-secondary" %>
              <%= button_to "Excluir", 
                            modelo_path(modelo), 
                            method: :delete,
                            data: { confirm: "Tem certeza que deseja excluir este template?" },
                            class: "btn btn-sm btn-danger" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    
    <!-- Paginação -->
    <div class="pagination-container">
      <%= paginate @modelos %>
    </div>
    
  <% else %>
    <div class="empty-state">
      <h3>Nenhum template encontrado</h3>
      <% if params[:busca].present? %>
        <p>Nenhum template corresponde à busca "<%= params[:busca] %>"</p>
        <%= link_to "Ver todos os templates", modelos_path, class: "btn btn-secondary" %>
      <% else %>
        <p>Ainda não há templates criados no sistema.</p>
        <% if administrador? %>
          <%= link_to "Criar Primeiro Template", new_modelo_path, class: "btn btn-primary" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
